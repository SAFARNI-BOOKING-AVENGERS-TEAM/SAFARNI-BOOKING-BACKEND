PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/safarni
FRONTEND_URL=http://localhost:3000

# Authentication
ACCESS_TOKEN_SECRET=replace_with_a_long_random_secret
REFRESH_TOKEN_SECRET=replace_with_a_different_long_random_secret
ACCESS_TOKEN_EXPIRES_DEVELOPMENT=1d
ACCESS_TOKEN_EXPIRES=1h
REFRESH_TOKEN_EXPIRES=7d

# Stripe test mode
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Optional Cloudinary uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Ask SAFARNI - AI intent parsing
OPENAI_API_KEY=
OPENAI_SEARCH_MODEL=gpt-5-mini

# Ask SAFARNI - n8n live flight aggregation
N8N_FLIGHT_SEARCH_WEBHOOK_URL=https://your-n8n-host/webhook/safarni-flight-search-v2
N8N_WEBHOOK_SECRET=replace_with_a_long_random_shared_secret
FLIGHT_SEARCH_REGION=DE
